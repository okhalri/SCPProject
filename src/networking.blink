option TypesOutput = "ReplicatedStorage/Blink/Types.luau"
option ServerOutput = "ServerStorage/Blink/Server.luau"
option ClientOutput = "ReplicatedStorage/Blink/Client.luau"

scope ActorSystem {
    event RequestSCP {
        From: Client,
        Type: Reliable,
        Call: SingleAsync,
        Data: u16
    }

    event ResponseSCP {
        From: Server,
        Type: Reliable,
        Call: SingleAsync,
        Data: struct {
            Allowed: boolean,
            Reason: string?
        }
    }

    event RequestMove {
        From: Client,
        Type: Reliable,
        Call: SingleAsync,
        Data: struct {
            Move: string,
            Data: unknown
        }
    }

    event ResponseMove {
        From: Server,
        Type: Reliable,
        Call: SingleAsync,
        Data: struct {
            Move: string,
            Allowed: boolean,
            Reason: string?
        }
    }
}

scope EffectsSystem {
    event RunEffect {
        From: Server,
        Type: Reliable,
        Call: SingleAsync,
        Data: struct {
            Effect: string,
            Targets: Instance(Model)[]
        }
    }

    event StopEffect {
        From: Server,
        Type: Reliable,
        Call: SingleAsync,
        Data: struct {
            Effect: string,
            Targets: Instance(Model)[]
        }
    }
}

scope TeamSystem {
    struct PlayerData {
        Team: string,
        SubTeam: string,
        GroupRank: number,
    }

    map PlayerToPlayerData {
        [Instance(Player)]: PlayerData
    }

    event RequestAll {
        From: Client,
        Type: Reliable,
        Call: SingleAsync,
        Data: boolean
    },

    event RequestArray {
        From: Client, 
        Type: Reliable,
        Call: SingleAsync,
        Data: Instance(Player)[]
    }

    event Update {
        From: Server,
        Type: Reliable,
        Call: SingleAsync,
        Data: PlayerToPlayerData
    }

    event Clear {
        From: Server, 
        Type: Reliable,
        Call: SingleAsync,
        Data: Instance(Player)[]
    }
}

scope GunSystem {

}